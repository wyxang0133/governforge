# ---------- builder ----------
FROM python:3.12-slim AS builder

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY governforge/pyproject.toml governforge/uv.lock ./
COPY governforge/src/ ./src/

RUN uv sync --frozen

# ---------- runner ----------
FROM python:3.12-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy virtualenv from builder
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

RUN groupadd --gid 10001 governforge && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin governforge

# Copy source code
COPY governforge/src/ /app/src/
COPY governforge/alembic.ini /app/alembic.ini
COPY governforge/migrations /app/migrations

EXPOSE 8000

USER 10001:10001

CMD ["sh", "-c", "alembic -c /app/alembic.ini upgrade head && uvicorn governforge.main:app --host 0.0.0.0 --port 8000"]
