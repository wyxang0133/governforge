FROM python:3.12-slim
RUN pip install --no-cache-dir uv
WORKDIR /workspace
COPY governforge/pyproject.toml governforge/uv.lock ./
COPY governforge/src ./src
RUN uv sync --frozen --extra dev
COPY governforge/tests ./tests
ENV PATH="/workspace/.venv/bin:$PATH" PYTHONPATH=/workspace/src PYTHONDONTWRITEBYTECODE=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin governforge-test && \
    chown -R 10001:10001 /workspace
USER 10001:10001
CMD ["pytest", "-q"]
