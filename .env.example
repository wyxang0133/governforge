# Copy to .env only for local Docker development. Do not commit .env.
ENVIRONMENT=development
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=replace-with-a-long-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_CHECKS_ENABLED=false
GITHUB_CHECKS_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Use a secret manager in production. Escaped newlines (\\n) are supported.
GITHUB_APP_PRIVATE_KEY=
# Local Docker-friendly alternative to GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/governforge/github-app.pem
GITHUB_API_URL=https://api.github.com
MONTHLY_BUDGET_USD=0
CORS_ORIGINS=http://localhost:3000
ALLOW_SELF_REGISTRATION=true
ALLOW_LOCAL_AUTH=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_DEFAULT_WORKSPACE=ai_platform
SCIM_ENABLED=false
SCIM_BEARER_TOKEN=
SCIM_DEFAULT_WORKSPACE=ai_platform
DOMAIN=localhost
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=governforge-api
# Provider secrets are referenced by model routes and never persisted in the database.
MODEL_PROVIDER_OPENAI_API_KEY=
MODEL_PROVIDER_ANTHROPIC_API_KEY=
OTEL_SAMPLE_RATIO=0.1
LOG_LEVEL=INFO
LOG_JSON=false
WORKER_METRICS_PORT=9100
# Optional OpenAI-compatible endpoint. Disabled keeps the zero-cost extractive RAG fallback.
KNOWLEDGE_LLM_ENABLED=false
KNOWLEDGE_LLM_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_LLM_API_KEY=
KNOWLEDGE_LLM_MODEL=gpt-4.1-mini
KNOWLEDGE_LLM_TIMEOUT_SECONDS=20
KNOWLEDGE_INPUT_COST_PER_MILLION=0
KNOWLEDGE_OUTPUT_COST_PER_MILLION=0
KNOWLEDGE_MAX_UPLOAD_BYTES=5242880
